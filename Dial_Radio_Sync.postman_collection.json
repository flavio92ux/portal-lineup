						"{{baseUrl}}"
					],
					"path": [
						"api",
						"cron",
						"sync-dialradio"
					],
					"query": [
						{
							"key": "secret",
							"value": "{{cronSecret}}",
							"description": "Token secreto correspondente a CRON_SECRET"
						}
					]
				},
				"description": "Executa a sincronização unificada passando o token pela URL (?secret=). Ideal para serviços de cron externos como cron-job.org."
			},
			"response": []
		},
