			"name": "1. Sincronizar Ambas as Fontes (Bearer Token)",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{cronSecret}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/cron/sync-dialradio",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"cron",
						"sync-dialradio"
					]
				},
				"description": "Executa a mesma cron da Vercel: sincroniza tanto o Dial Rádio quanto o Tudo Rádio em sequência e retorna o relatório consolidado com autenticação via Bearer token."
			},
			"response": []
		},
		{
